# ------- Server -------
PORT=5000
NODE_ENV=development

# ------- CORS -------
# Frontend origin (Vite dev server default). Comma-separate multiple origins, or use * to allow all.
CLIENT_URL=http://localhost:5173

# ------- Database -------
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/kora?appName=KORA
# ------- Auth (JWT) -------
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
