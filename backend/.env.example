# ─────────────────────────────────────────────────────────────────────────────
# JANMITRA / KORA Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ------- Server -------
PORT=5000
NODE_ENV=development            # development | production | test

# ------- CORS -------
# Frontend origin (Vite dev server default).
# Comma-separate multiple origins, or use * to allow all.
CLIENT_URL=http://localhost:5173

# ------- Database -------
# MongoDB Atlas connection string (replace placeholders).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/kora?appName=KORA
# For local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/kora

# ------- Auth (JWT) -------
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# ------- File Storage -------
# Which storage provider to use: local | S3
# local → files saved to uploads/documents/ on the server filesystem
# S3    → files uploaded to AWS S3 (requires AWS_* vars below)
STORAGE_PROVIDER=local

# AWS S3 (only required when STORAGE_PROVIDER=S3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ------- Twilio (Phone OTP) -------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# ------- Email (Resend) -------
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
